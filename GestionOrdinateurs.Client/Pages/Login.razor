@page "/login"

@inject IAuthentificationService AuthentificationService
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<div class="mb-3" style="max-width: 300px">
    <label for="login" class="form-label">Utilisateur</label>
    <input id="login" class="form-control" @bind="login" />
</div>

<div class="mb-3" style="max-width: 300px">
    <label for="motDePasse" class="form-label">Mot de passe</label>
    <input id="motDePasse" type="password" class="form-control" @bind="motDePasse" />
</div>

<button class="btn btn-primary" @onclick="SeConnecter" disabled="@(string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(motDePasse))">
    Se connecter
</button>

@if (messageErreur is not null)
{
    <div class="alert alert-danger mt-3">@messageErreur</div>
}

@code {
    private string login = "";

    private string motDePasse = "";

    private string? messageErreur;

    private async Task SeConnecter()
    {
        messageErreur = null;

        try
        {
            if (await AuthentificationService.ConnecterAsync(login, motDePasse))
                Navigation.NavigateTo("/");
            else
                messageErreur = "Utilisateur ou mot de passe incorrect.";
        }
        catch (HttpRequestException)
        {
            messageErreur = "Le service d'authentification est indisponible.";
        }
    }
}
