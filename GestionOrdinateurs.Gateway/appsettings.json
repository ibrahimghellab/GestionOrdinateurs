{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/GestionOrdinateurs"
  },
  "ReverseProxy": {
    "Routes": {
      "ordinateursRoute": {
        "ClusterId": "gestionOrdinateursCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },
      "reparationsRoute": {
        "ClusterId": "gestionOrdinateursCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateursCluster": {
        "Destinations": {
          "gestionOrdinateursApi": {
            "Address": "http://gestionordinateurs-api:5169/"
          }
        }
      }
    }
  }
}
